<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Drone.Agent.Headless</RootNamespace>
    <AssemblyName>velocity-drone-headless</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Drone.Core\Drone.Core.csproj" />
    <ProjectReference Include="..\Drone.MCP\Drone.MCP.csproj" />
    <ProjectReference Include="..\Drone.Services\Drone.Services.csproj" />
    <ProjectReference Include="..\Drone.System\Drone.System.csproj" />
    <ProjectReference Include="..\Drone.Autonomy\Drone.Autonomy.csproj" />
    <ProjectReference Include="..\Drone.Native\Drone.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
