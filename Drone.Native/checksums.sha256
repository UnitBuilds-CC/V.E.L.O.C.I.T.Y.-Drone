# SHA-256 checksums for pre-built native DLLs
# Verify with: sha256sum -c checksums.sha256
#
# These DLLs are pre-built binaries committed to the repository.
# To verify integrity after clone:
#   cd Drone.Native && sha256sum -c checksums.sha256
#
# To rebuild from source and update checksums:
#   cd Drone.Native && cargo build --release
#   cp target/release/velocity_delta.dll .
#   sha256sum velocity_delta.dll velocity_v2_ffi.dll > checksums.sha256

